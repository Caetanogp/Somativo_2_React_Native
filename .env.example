# Copie este arquivo para ".env" e preencha com as chaves do SEU projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Config do SDK).
# O arquivo ".env" está no .gitignore e NUNCA deve ser commitado.
#
# Deixe tudo em branco para rodar 100% local (AsyncStorage + login local com hash).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
